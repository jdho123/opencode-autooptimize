{
	"name": "opencode-autooptimize",
	"version": "0.0.1",
	"description": "A plugin for OpenCode that adds a command to automatically optimize any given code, using a propose, implement, and test approach",
	"author": "Johnny Ho",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"opencode",
		"plugin",
		"optimize",
		"refactor"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
		"prepublishOnly": "bun run build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format-and-lint": "biome check --write .",
		"format-and-lint-check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"tsup": "^8.5.1",
		"typescript": "5.7.3"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.70",
		"@opencode-ai/plugin": "^1.18.13",
		"@opencode-ai/sdk": "^1.18.13",
		"fast-glob": "^3.3.3",
		"zod": "^4.4.3"
	}
}
